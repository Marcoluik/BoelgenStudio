---
import "@fontsource-variable/archivo/wdth.css";
import "../styles/global.css";
import Cart from "../components/Cart.astro";
import CookieConsent from "../components/CookieConsent.astro";
import Footer from "../components/Footer.astro";
import Navigation from "../components/Navigation.astro";
import Toasts from "../components/Toasts.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Navigationen ligger gennemsigtig oven på en hero */
  overlayNav?: boolean;
  /** JSON-LD (schema.org) til søgemaskiner */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: "website" | "product";
}

const {
  title,
  description = "Bølgen Studio laver tøj til livet ved havet. Tung dobbeltlags-hoodie med broderet kaligrafi. Designet i København.",
  image = "/hero-2-Gv_c13hE.jpeg",
  overlayNav = false,
  jsonLd,
  ogType = "website",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const ldBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f5f6f4" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Bølgen Studio" />
    <meta property="og:locale" content="da_DK" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    {ldBlocks.map((block) => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
    <slot name="head" />
  </head>
  <body>
    <a
      href="#indhold"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[200] focus:bg-ink focus:px-4 focus:py-3 focus:text-ground"
    >
      Spring til indhold
    </a>
    <Navigation overlay={overlayNav} />
    <div id="indhold">
      <slot />
    </div>
    <Footer />
    <Cart />
    <Toasts />
    <CookieConsent />

    <script>
      // Blød rulning slås først til efter indlæsning (se global.css)
      const enableSmooth = () => setTimeout(() => document.documentElement.classList.add("smooth"), 300);
      if (document.readyState === "complete") enableSmooth();
      else window.addEventListener("load", enableSmooth, { once: true });

      // Når kurv eller størrelsesguide er åben, må baggrunden ikke rulle. Scrollbaren bliver
      // stående (at skjule den får siden til at hoppe); i stedet stoppes rul, der ikke
      // rammer et rullbart område inde i dialogen.
      const blockBackgroundScroll = (e: Event) => {
        const dialog = document.querySelector('dialog[open], .cart[data-open="true"]');
        if (!dialog) return;
        let el = e.target instanceof Element ? e.target : null;
        while (el && el !== dialog && dialog.contains(el)) {
          const canScroll =
            el.scrollHeight > el.clientHeight + 1 && /(auto|scroll)/.test(getComputedStyle(el).overflowY);
          if (canScroll) return;
          el = el.parentElement;
        }
        if (e.cancelable) e.preventDefault();
      };
      document.addEventListener("wheel", blockBackgroundScroll, { passive: false });
      document.addEventListener("touchmove", blockBackgroundScroll, { passive: false });
    </script>
  </body>
</html>
