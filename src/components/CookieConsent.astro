---
// Cookie-samtykke: valget gemmes i localStorage ("accepted" / "declined").
// Analyse-scripts må først indlæses, når valget er "accepted" (se accept()).
---

<div
  id="cookie-consent"
  class="cookie pointer-events-none invisible fixed inset-x-0 bottom-0 z-[90] p-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] sm:inset-x-auto sm:left-4 sm:p-0 sm:pb-4"
  role="region"
  aria-label="Cookies"
>
  <div class="cookie-panel pointer-events-auto max-w-sm border bg-surface p-5 hairline">
    <p class="text-sm text-ink-dim">
      Vi bruger cookies til at forbedre din oplevelse og analysere trafik.
      <a href="/privacy" class="link text-ink">Privatlivspolitik</a>
    </p>
    <div class="mt-4 flex gap-2">
      <button id="cookie-accept" type="button" class="btn btn-primary !min-h-[2.75rem] flex-1 px-4 text-sm">Accepter</button>
      <button id="cookie-decline" type="button" class="btn btn-ghost !min-h-[2.75rem] flex-1 px-4 text-sm">Afvis</button>
    </div>
  </div>
</div>

<script>
  const KEY = "bolgen-cookie-consent";
  const banner = document.getElementById("cookie-consent");

  function hide() {
    banner?.classList.remove("is-in");
    setTimeout(() => banner?.classList.add("invisible"), 400);
  }

  function choose(value: "accepted" | "declined") {
    try {
      localStorage.setItem(KEY, value);
    } catch {
      /* ignorer */
    }
    hide();
    // Her kan analyse slås til, når value === "accepted"
  }

  function init() {
    let stored: string | null = null;
    try {
      stored = localStorage.getItem(KEY);
    } catch {
      /* ignorer */
    }
    if (stored || !banner) return;
    banner.classList.remove("invisible");
    requestAnimationFrame(() => banner.classList.add("is-in"));
  }

  document.getElementById("cookie-accept")?.addEventListener("click", () => choose("accepted"));
  document.getElementById("cookie-decline")?.addEventListener("click", () => choose("declined"));

  // Vent lidt, så banneret ikke konkurrerer med første indtryk
  if (document.readyState === "complete") setTimeout(init, 1800);
  else window.addEventListener("load", () => setTimeout(init, 1800));
</script>

<style>
  .cookie-panel {
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.6);
    opacity: 0;
    transform: translateY(1rem);
    transition:
      opacity 0.4s var(--ease-out),
      transform 0.4s var(--ease-out);
  }

  .cookie.is-in .cookie-panel {
    opacity: 1;
    transform: none;
  }
</style>
