---
// Små beskeder i bunden af skærmen i stedet for alert()
---

<div
  id="toasts"
  class="pointer-events-none fixed inset-x-0 bottom-0 z-[150] flex flex-col items-center gap-2 px-4 pb-[max(1.25rem,env(safe-area-inset-bottom))]"
  role="status"
  aria-live="polite"
>
</div>

<script>
  const host = document.getElementById("toasts");

  window.addEventListener("toast", (e) => {
    if (!host) return;
    const { message, tone } = (e as CustomEvent<{ message: string; tone?: string }>).detail;
    const el = document.createElement("div");
    el.className = "toast";
    el.dataset.tone = tone ?? "info";
    el.textContent = message;
    host.appendChild(el);
    requestAnimationFrame(() => el.classList.add("is-in"));
    setTimeout(() => {
      el.classList.remove("is-in");
      setTimeout(() => el.remove(), 400);
    }, 4200);
  });
</script>

<style is:global>
  .toast {
    pointer-events: auto;
    max-width: 26rem;
    padding: 0.85rem 1.15rem;
    border-radius: 999px;
    background: var(--ink);
    color: var(--ground);
    font-size: 0.9375rem;
    font-weight: 500;
    box-shadow: 0 12px 40px rgb(0 0 0 / 0.5);
    opacity: 0;
    transform: translateY(0.75rem);
    transition:
      opacity 0.35s var(--ease-out),
      transform 0.35s var(--ease-out);
  }

  .toast[data-tone="error"] {
    background: #f2b256;
  }

  .toast.is-in {
    opacity: 1;
    transform: none;
  }
</style>
