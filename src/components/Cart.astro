---
import { buildCartCatalog, buildThumbMap, getProducts } from "../lib/products";

const products = await getProducts();
// Kurven gemmer kun variant-id og antal; navn, pris og foto slås op her.
const thumbs = buildThumbMap(products);
const catalog = buildCartCatalog(products);
---

<!--
  Kurven er et helt almindeligt fast panel, der glider ind fra højre. Ingen <dialog>, intet
  top-layer og ingen ændring af sidens scrollbar: det eneste, der sker ved åbning, er at
  panelet flytter sig og baggrunden tones ned.
-->
<div id="cart" class="cart" data-open="false">
  <div class="cart-scrim" data-cart-close></div>

  <aside class="cart-panel" role="dialog" aria-modal="true" aria-labelledby="cart-title" tabindex="-1">
    <header class="flex items-center justify-between px-5 py-4 sm:px-7">
      <h2 id="cart-title" class="flex items-baseline gap-3 text-xl font-semibold">
        Kurv
        <span class="label" data-cart-summary></span>
      </h2>
      <button type="button" class="link -mr-2 min-h-[2.75rem] px-2" data-cart-close>Luk</button>
    </header>

    <div class="flex-1 overflow-y-auto overscroll-contain px-5 sm:px-7" data-cart-body>
      <div class="hidden pt-6" data-cart-empty>
        <p class="text-lg font-semibold">Kurven er tom</p>
        <p class="mt-1 text-ink-dim">Hoodien findes i hvid og sort.</p>
        <a href="/#shop" class="btn btn-primary mt-6" data-cart-close>Se hoodien</a>
      </div>
      <ul class="hidden" data-cart-lines></ul>
    </div>

    <footer class="hidden px-5 pb-[max(1.25rem,env(safe-area-inset-bottom))] pt-5 sm:px-7" data-cart-footer>
      <p class="mb-4 hidden text-sm text-amber" role="alert" data-cart-error></p>
      <div class="flex items-baseline justify-between">
        <span class="text-ink-dim">Subtotal</span>
        <span class="text-xl font-semibold" data-cart-subtotal></span>
      </div>
      <p class="mt-1 text-sm text-ink-mute">Inkl. moms. Fragt beregnes ved kassen.</p>
      <button type="button" class="btn btn-primary mt-5 w-full" data-cart-checkout>
        <span data-cart-checkout-label>Gå til kassen</span>
      </button>
      <p class="label mt-4 text-center">Levering på 2–4 hverdage. 14 dages returret.</p>
    </footer>
  </aside>
</div>

<script type="application/json" id="cart-thumbs" set:html={JSON.stringify(thumbs)} />
<script type="application/json" id="cart-catalog" set:html={JSON.stringify(catalog)} />

<script>
  import {
    CheckoutError,
    loadCart,
    onCartChange,
    removeLine,
    setLineQuantity,
    startCheckout,
    type Cart,
    type CartLine,
  } from "../lib/cart";
  import { formatMoney } from "../lib/money";
  import { refreshStock } from "../lib/stock";

  const cartEl = document.getElementById("cart");
  const panel = cartEl?.querySelector<HTMLElement>(".cart-panel");
  const linesEl = cartEl?.querySelector<HTMLUListElement>("[data-cart-lines]");
  const emptyEl = cartEl?.querySelector<HTMLElement>("[data-cart-empty]");
  const footerEl = cartEl?.querySelector<HTMLElement>("[data-cart-footer]");
  const subtotalEl = cartEl?.querySelector<HTMLElement>("[data-cart-subtotal]");
  const summaryEl = cartEl?.querySelector<HTMLElement>("[data-cart-summary]");
  const errorEl = cartEl?.querySelector<HTMLElement>("[data-cart-error]");
  const checkoutBtn = cartEl?.querySelector<HTMLButtonElement>("[data-cart-checkout]");
  const checkoutLabel = cartEl?.querySelector<HTMLElement>("[data-cart-checkout-label]");

  const thumbs: Record<string, { src: string; style: string }> = JSON.parse(
    document.getElementById("cart-thumbs")?.textContent || "{}"
  );

  const key = (value: string) =>
    value
      .normalize("NFKD")
      .replace(/\p{M}/gu, "")
      .replace(/ø/gi, "o")
      .toLowerCase();

  function el<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    className = "",
    text?: string
  ): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function renderLine(line: CartLine): HTMLLIElement {
    const { merchandise } = line;
    const color = merchandise.selectedOptions.find((o) => /^(farve|colou?r)$/i.test(o.name))?.value ?? "";
    const options = merchandise.selectedOptions
      .filter((o) => o.value && o.value !== "Default Title")
      .map((o) => o.value);
    const href = `/product/${merchandise.product.handle}${color ? `?color=${encodeURIComponent(key(color))}` : ""}`;
    const local = thumbs[`${merchandise.product.handle}|${key(color)}`];
    const thumbSrc = local?.src;

    const li = el("li", "cart-line");
    li.dataset.lineId = line.id;

    const thumb = el("a", "cart-thumb");
    thumb.href = href;
    thumb.tabIndex = -1;
    thumb.setAttribute("aria-hidden", "true");
    if (thumbSrc) {
      const img = el("img");
      img.src = thumbSrc;
      if (local?.style) img.style.cssText = local.style;
      img.alt = "";
      img.decoding = "async";
      thumb.appendChild(img);
    }

    const info = el("div", "min-w-0");
    const title = el("a", "block truncate font-semibold hover:underline", merchandise.product.title);
    title.href = href;
    info.append(title, el("p", "mt-0.5 text-ink-dim", options.join(", ")));

    const controls = el("div", "mt-3 flex items-center gap-4");
    const stepper = el("div", "cart-stepper");
    const minus = el("button", "", "−");
    minus.type = "button";
    minus.dataset.qty = String(line.quantity - 1);
    minus.setAttribute("aria-label", `Én færre ${merchandise.product.title} ${options.join(" ")}`);
    const qty = el("span", "", String(line.quantity));
    qty.setAttribute("aria-label", `Antal: ${line.quantity}`);
    const plus = el("button", "", "+");
    plus.type = "button";
    plus.dataset.qty = String(line.quantity + 1);
    plus.setAttribute("aria-label", `Én mere ${merchandise.product.title} ${options.join(" ")}`);
    stepper.append(minus, qty, plus);

    const remove = el("button", "link text-sm text-ink-dim", "Fjern");
    remove.type = "button";
    remove.dataset.remove = "true";
    remove.setAttribute("aria-label", `Fjern ${merchandise.product.title} ${options.join(" ")}`);
    controls.append(stepper, remove);
    info.appendChild(controls);

    const price = el(
      "p",
      "whitespace-nowrap font-semibold",
      formatMoney(line.cost.totalAmount.amount, line.cost.totalAmount.currencyCode)
    );

    li.append(thumb, info, price);
    return li;
  }

  function showError(message: string) {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.classList.toggle("hidden", !message);
  }

  let lastSync = 0;

  function render(cart: Cart | null) {
    lastSync = Date.now();
    const lines = cart?.lines.edges.map((e) => e.node) ?? [];
    const count = cart?.totalQuantity ?? 0;
    const isEmpty = lines.length === 0;

    document.querySelectorAll<HTMLElement>("[data-cart-count]").forEach((badge) => {
      badge.textContent = String(count);
      badge.dataset.empty = String(count === 0);
    });
    document.querySelectorAll<HTMLElement>("[data-cart-count-label]").forEach((label) => {
      label.textContent = count === 0 ? "Kurven er tom" : `${count} ${count === 1 ? "vare" : "varer"} i kurven`;
    });

    if (!linesEl || !emptyEl || !footerEl) return;
    emptyEl.classList.toggle("hidden", !isEmpty);
    linesEl.classList.toggle("hidden", isEmpty);
    footerEl.classList.toggle("hidden", isEmpty);
    if (summaryEl) summaryEl.textContent = isEmpty ? "" : `${count} ${count === 1 ? "vare" : "varer"}`;

    // Tegn kun linjerne om, når indholdet faktisk er ændret
    const signature = lines.map((l) => `${l.id}:${l.quantity}:${l.cost.totalAmount.amount}`).join("|");
    if (linesEl.dataset.signature !== signature) {
      linesEl.dataset.signature = signature;
      linesEl.replaceChildren(...lines.map(renderLine));
    }
    linesEl.removeAttribute("aria-busy");

    if (subtotalEl && cart) {
      subtotalEl.textContent = formatMoney(cart.cost.subtotalAmount.amount, cart.cost.subtotalAmount.currencyCode);
    }
  }

  // Resten af siden gøres utilgængelig for tastatur og skærmlæser, mens kurven er åben
  const background = () =>
    Array.from(document.body.children).filter(
      (node): node is HTMLElement => node instanceof HTMLElement && node !== cartEl && node.id !== "toasts"
    );

  let returnFocus: HTMLElement | null = null;
  const isOpen = () => cartEl?.dataset.open === "true";

  function open() {
    if (!cartEl || !panel || isOpen()) return;
    showError("");
    resetCheckout();
    returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    cartEl.dataset.open = "true";
    background().forEach((node) => node.setAttribute("inert", ""));
    panel.focus({ preventScroll: true });
    // Indholdet er allerede tegnet. Hent kun igen, hvis det er et stykke tid siden sidst.
    if (Date.now() - lastSync > 30_000) void loadCart(true);
  }

  function close() {
    if (!cartEl || !isOpen()) return;
    cartEl.dataset.open = "false";
    background().forEach((node) => node.removeAttribute("inert"));
    returnFocus?.focus({ preventScroll: true });
    returnFocus = null;
  }

  function resetCheckout() {
    if (!checkoutBtn || !checkoutLabel) return;
    checkoutBtn.disabled = false;
    checkoutLabel.textContent = "Gå til kassen";
  }

  async function mutate(action: () => Promise<unknown>) {
    if (!linesEl || linesEl.getAttribute("aria-busy") === "true") return;
    linesEl.setAttribute("aria-busy", "true");
    showError("");
    try {
      await action();
    } catch (err) {
      console.error("[kurv]", err);
      showError("Kurven blev ikke opdateret. Prøv igen.");
      linesEl.removeAttribute("aria-busy");
    }
  }

  linesEl?.addEventListener("click", (e) => {
    const button = (e.target as Element).closest<HTMLButtonElement>("button");
    const lineId = button?.closest<HTMLElement>("[data-line-id]")?.dataset.lineId;
    if (!button || !lineId) return;
    if (button.dataset.remove) void mutate(() => removeLine(lineId));
    else if (button.dataset.qty !== undefined) {
      void mutate(() => setLineQuantity(lineId, parseInt(button.dataset.qty ?? "1", 10)));
    }
  });

  checkoutBtn?.addEventListener("click", async () => {
    if (!checkoutLabel) return;
    checkoutBtn.disabled = true;
    checkoutLabel.textContent = "Åbner kassen…";
    showError("");
    try {
      // Serveren tjekker lager og pris og sender os videre til Stripes betalingsside
      window.location.assign(await startCheckout());
    } catch (err) {
      if (!(err instanceof CheckoutError)) console.error("[kasse]", err);
      showError(
        err instanceof CheckoutError ? err.message : "Kassen kunne ikke åbnes. Prøv igen, eller skriv til os."
      );
      resetCheckout();
    }
  });

  document.addEventListener("click", (e) => {
    const target = e.target as Element;
    if (target.closest("[data-cart-open]")) open();
    else if (target.closest("[data-cart-close]")) close();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen()) close();
  });

  window.addEventListener("cart:open", open);
  onCartChange(render);

  // Tilbage fra kassen via browserens tilbageknap: hent frisk kurv
  window.addEventListener("pageshow", (e) => {
    if (e.persisted) {
      resetCheckout();
      void loadCart(true);
    }
  });

  const boot = () => {
    void loadCart();
    void refreshStock();
  };
  if ("requestIdleCallback" in window) requestIdleCallback(boot, { timeout: 2000 });
  else setTimeout(boot, 300);
</script>

<style is:global>
  .cart {
    position: fixed;
    inset: 0;
    z-index: 100;
    visibility: hidden;
    pointer-events: none;
    /* Bliv synlig, indtil panelet er gledet ud */
    transition: visibility 0s linear 0.28s;
  }

  .cart[data-open="true"] {
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  .cart-scrim {
    position: absolute;
    inset: 0;
    background: rgb(4 8 20 / 0.55);
    opacity: 0;
    transition: opacity 0.28s ease;
  }

  .cart[data-open="true"] .cart-scrim {
    opacity: 1;
  }

  .cart-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    width: min(100%, 27rem);
    background: var(--ground);
    color: var(--ink);
    transform: translateX(100%);
    transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
    padding-top: env(safe-area-inset-top);
    outline: none;
  }

  .cart[data-open="true"] .cart-panel {
    transform: none;
  }

  .cart-line {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) auto;
    gap: 1rem;
    padding-block: 1rem;
  }

  [data-cart-lines][aria-busy="true"] {
    opacity: 0.5;
    pointer-events: none;
  }

  .cart-thumb {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--surface-2);
  }

  .cart-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-stepper {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
  }

  .cart-stepper button {
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1.05rem;
    line-height: 1;
    color: var(--ink);
    border-radius: 999px;
    touch-action: manipulation;
  }

  .cart-stepper button:hover {
    background: var(--surface-2);
  }

  .cart-stepper span {
    min-width: 1.75rem;
    text-align: center;
    font-weight: 600;
  }
</style>
