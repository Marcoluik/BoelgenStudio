---
const formSubmitRecipient =
  import.meta.env.PUBLIC_FORMSUBMIT_RECIPIENT?.trim() || "8713123e93f6baf78af5e327439c1129";
const useFormSubmit = Boolean(formSubmitRecipient);
const siteBase = import.meta.env.SITE?.replace(/\/$/, "") ?? "";
const newsletterAction = useFormSubmit
  ? `https://formsubmit.co/${encodeURIComponent(formSubmitRecipient)}`
  : undefined;
const newsletterNext = useFormSubmit && siteBase ? `${siteBase}/?tilmeldt=1` : "";

const links = [
  { href: "/#shop", label: "Shop" },
  { href: "/shipping#size-guide", label: "Størrelsesguide" },
  { href: "/shipping", label: "Fragt og returnering" },
  { href: "/contact", label: "Kontakt" },
  { href: "https://instagram.com/boelgen.studio", label: "Instagram", external: true },
];
---

<!-- Broderiet vendt om: hvid skrift på trådens blå -->
<footer class="site-footer" data-theme="sort">
  <div class="wrap grid gap-12 py-16 sm:py-20 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-6">
      <h2 class="text-2xl font-semibold sm:text-3xl">Få besked om næste kollektion</h2>
      <form
        name="newsletter"
        method="POST"
        class="mt-6 flex max-w-md items-end gap-4"
        {...useFormSubmit
          ? { action: newsletterAction }
          : { "data-netlify": "true", "netlify-honeypot": "newsletter-bot" }}
      >
        {
          useFormSubmit ? (
            <>
              <input type="hidden" name="_subject" value="Nyhedsbrev — Bølgen Studio" />
              {newsletterNext && <input type="hidden" name="_next" value={newsletterNext} />}
            </>
          ) : (
            <>
              <input type="hidden" name="form-name" value="newsletter" />
              <p class="hidden">
                <label>
                  Udfyld ikke dette: <input name="newsletter-bot" />
                </label>
              </p>
            </>
          )
        }
        <label class="flex-1">
          <span class="sr-only">E-mailadresse</span>
          <input type="email" name="email" required autocomplete="email" placeholder="din@email.dk" class="field" />
        </label>
        <button type="submit" class="btn footer-btn !min-h-[3rem] px-6">Tilmeld</button>
      </form>
      <p class="mt-4 max-w-md text-sm text-white/75">
        Vi skriver kun, når der kommer noget nyt. Se <a href="/privacy" class="link">privatlivspolitikken</a>.
      </p>
    </div>

    <nav class="lg:col-span-5 lg:col-start-8" aria-label="Sidefod">
      <ul class="grid grid-cols-2 gap-x-8 gap-y-1 text-lg">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="inline-flex min-h-[2.75rem] items-center hover:underline hover:underline-offset-4"
                {...("external" in link ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="wrap">
    <span class="wordmark w-full" aria-hidden="true"></span>
  </div>

  <div class="wrap flex flex-col items-center justify-between gap-2 py-6 pb-[max(1.5rem,env(safe-area-inset-bottom))] text-sm text-white/75 sm:flex-row">
    <p>© {new Date().getFullYear()} Bølgen Studio, København</p>
    <ul class="flex gap-6">
      <li><a href="/privacy" class="inline-flex min-h-[2.5rem] items-center hover:text-white">Privatlivspolitik</a></li>
      <li><a href="/terms" class="inline-flex min-h-[2.5rem] items-center hover:text-white">Salgsvilkår</a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: rgb(31 92 204);
    color: #fff;
  }

  .site-footer .field {
    color: #fff;
    border-color: rgb(255 255 255 / 0.6);
  }

  .site-footer .field::placeholder {
    color: rgb(255 255 255 / 0.65);
  }

  .site-footer .field:focus {
    border-color: #fff;
  }

  .site-footer :focus-visible {
    outline-color: #fff;
  }

  .footer-btn {
    background: #fff;
    color: rgb(31 92 204);
  }

  .footer-btn:hover {
    background: rgb(14 27 61);
    color: #fff;
  }
</style>
