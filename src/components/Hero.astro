---
interface Props {
  price?: string;
}

const { price } = Astro.props;
---

<!-- Havet først: videoen og jeres egen håndskrift er det mest genkendelige ved Bølgen -->
<section class="hero relative isolate flex flex-col overflow-hidden" data-theme="sort">
  <div class="absolute inset-0 -z-10">
    <video
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      class="hero-video h-full w-full object-cover"
      aria-hidden="true"
      tabindex="-1"
    >
      <source src="/hero-video.mp4" type="video/mp4" />
    </video>
    <div class="hero-shade absolute inset-0"></div>
  </div>

  <div class="wrap flex flex-1 flex-col items-center justify-center pb-16 pt-[calc(var(--nav-h)+2rem)] text-center text-white">
    <h1 class="hero-rise" style="--d: 0.1s">
      <span class="wordmark mx-auto h-32 sm:h-52 lg:h-64" role="img" aria-label="Bølgen"></span>
    </h1>
    <p class="hero-rise mt-4 text-xl font-medium sm:mt-6 sm:text-2xl" style="--d: 0.25s">Sommer. Havet. Venner.</p>
    <a href="#shop" class="btn hero-btn hero-rise mt-8 sm:mt-10" style="--d: 0.4s">
      Se hoodien{price && <span class="font-normal opacity-70">{price}</span>}
    </a>
  </div>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>(".hero-video");
  if (video) {
    const ready = () => video.classList.add("is-ready");
    if (video.readyState >= 2) ready();
    else video.addEventListener("loadeddata", ready, { once: true });

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      video.removeAttribute("autoplay");
      video.pause();
    } else {
      video.play().catch(() => {});
    }
  }
</script>

<style>
  .hero {
    min-height: 100svh;
    background: #04121f;
  }

  .hero-video {
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .hero-video.is-ready {
    opacity: 1;
  }

  /* Lidt mørkere i top og bund, så menu og tekst kan læses oven på vandet */
  .hero-shade {
    background: linear-gradient(to bottom, rgb(4 18 31 / 0.5) 0%, rgb(4 18 31 / 0.1) 30%, rgb(4 18 31 / 0.25) 100%);
  }

  .hero-btn {
    background: #fff;
    color: rgb(31 92 204);
    min-width: 13rem;
  }

  .hero-btn:hover {
    background: rgb(31 92 204);
    color: #fff;
  }

  /* Sidens ene indgangsanimation */
  .hero-rise {
    animation: rise 1s var(--ease-out) both;
    animation-delay: var(--d, 0s);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
  }
</style>
