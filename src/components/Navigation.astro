---
interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const pathname = Astro.url.pathname;
const links = [
  { href: "/#shop", label: "Shop", current: false },
  { href: "/shipping#size-guide", label: "Størrelser", current: false },
  { href: "/contact", label: "Kontakt", current: pathname.startsWith("/contact") },
];
---

<header
  class="site-nav fixed inset-x-0 top-0 z-50"
  data-overlay={overlay ? "true" : undefined}
  data-theme={overlay ? "sort" : undefined}
  data-stuck="false"
>
  <nav class="wrap flex h-[var(--nav-h)] items-center justify-between gap-4" aria-label="Hovedmenu">
    <ul class="flex min-w-0 flex-1 items-center gap-5 sm:gap-8">
      {
        links.map((link, i) => (
          <li class={i > 0 ? "hidden sm:block" : ""}>
            <a
              href={link.href}
              class="nav-link inline-flex min-h-[2.75rem] items-center text-[0.9375rem] font-medium"
              aria-current={link.current ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a href="/" class="shrink-0 px-2 py-2" aria-label="Bølgen Studio, til forsiden">
      <span class="wordmark h-7 sm:h-9"></span>
    </a>

    <div class="flex flex-1 items-center justify-end gap-5 sm:gap-8">
      <a
        href="https://instagram.com/boelgen.studio"
        target="_blank"
        rel="noopener noreferrer"
        class="nav-link hidden min-h-[2.75rem] items-center text-[0.9375rem] font-medium sm:inline-flex"
      >
        Instagram
      </a>
      <button
        type="button"
        class="nav-link inline-flex min-h-[2.75rem] items-center gap-2 text-[0.9375rem] font-medium"
        data-cart-open
        aria-haspopup="dialog"
        aria-controls="cart"
      >
        Kurv
        <span
          class="inline-flex h-6 min-w-6 items-center justify-center rounded-full border px-1.5 text-xs font-medium leading-none"
          data-cart-count
          data-empty="true"
          aria-hidden="true">0</span
        >
        <span class="sr-only" data-cart-count-label>Kurven er tom</span>
      </button>
      <!-- Sæt tælleren fra sidste kendte antal før første tegning, så den ikke blinker 0 → n -->
      <script is:inline>
        (function () {
          try {
            var n = parseInt(localStorage.getItem("bolgen_cart_count") || "0", 10) || 0;
            var badge = document.querySelector("[data-cart-count]");
            if (badge && n > 0) {
              badge.textContent = String(n);
              badge.dataset.empty = "false";
            }
          } catch (_) {}
        })();
      </script>
    </div>
  </nav>
</header>

<script>
  const nav = document.querySelector<HTMLElement>(".site-nav");
  if (nav) {
    const update = () => {
      const stuck = window.scrollY > 24;
      nav.dataset.stuck = String(stuck);
      // Oven på hero-videoen er menuen lys; så snart den får baggrund, følger den sidens tema
      if (nav.dataset.overlay) {
        if (stuck) delete nav.dataset.theme;
        else nav.dataset.theme = "sort";
      }
    };
    update();
    window.addEventListener("scroll", update, { passive: true });
  }
</script>

<style>
  .site-nav {
    color: var(--ink);
    background: color-mix(in srgb, var(--ground) 86%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid var(--line);
    padding-top: env(safe-area-inset-top);
    transition:
      background-color 0.4s var(--ease-out),
      border-color 0.4s var(--ease-out),
      backdrop-filter 0.4s var(--ease-out);
  }

  /* Helt i toppen: ingen baggrund og ingen linje. Den kommer først, når man ruller. */
  .site-nav[data-stuck="false"] {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: transparent;
  }

  .site-nav .wordmark {
    color: var(--thread);
  }

  .site-nav[data-theme] .wordmark {
    color: #fff;
  }

  .nav-link {
    position: relative;
    color: inherit;
    touch-action: manipulation;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.55rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-out);
  }

  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after {
    transform: scaleX(1);
  }

  button.nav-link::after {
    right: 2rem;
  }

  [data-cart-count] {
    border-color: var(--line-strong);
    color: var(--ink-dim);
  }

  [data-cart-count][data-empty="false"] {
    border-color: var(--button);
    background: var(--button);
    color: #fff;
  }
</style>
