---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Siden blev ikke fundet | Bølgen Studio" description="Siden du leder efter findes ikke.">
  <main class="wrap flex min-h-[100svh] flex-col items-start justify-center py-32">
    <h1 class="display text-[clamp(3.5rem,11vw,8rem)]">Siden findes ikke</h1>
    <p class="mt-6 max-w-md text-lg text-ink-dim">Adressen er forkert, eller siden er flyttet.</p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/#shop" class="btn btn-primary">Se kollektionen</a>
      <a href="/" class="btn btn-ghost">Til forsiden</a>
    </div>
  </main>
</Layout>
