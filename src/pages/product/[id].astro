---
import Layout from "../../layouts/Layout.astro";
import { focusCrop } from "../../lib/images";
import { getProducts, splitDescription } from "../../lib/products";
import { SIZE_CHART_ROWS } from "../../lib/size-chart";

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({
    params: { id: product.handle },
    props: {
      product,
      otherProducts: products.filter((p) => p.handle !== product.handle),
    },
  }));
}

const { product, otherProducts } = Astro.props;
const groups = product.colorGroups;
const firstGroup = groups.find((g) => g.available) ?? groups[0];
const { lead, rest } = splitDescription(product.description);
const shortName = product.name.replace(/^Bølgen\s+/i, "");

const specs = product.isSignature
  ? [
      ["Ydre lag", "370 gsm kraftig bomuld"],
      ["Inderlag", "280 gsm"],
      ["Materiale", "100% bomuld"],
      ["Lukning", "Lynlås i fuld længde"],
      ["Broderi", "Kaligrafi på ryggen, bølgelogo ved håndleddet"],
      ["Pasform", "Sidder en smule cropped"],
    ]
  : [];

const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const absolute = (src: string) => (src.startsWith("http") ? src : `${site}${src}`);
const pageUrl = `${site}/product/${product.handle}`;
const ogImage = firstGroup?.pics[0]?.src;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.name,
  description: product.description,
  image: groups.flatMap((g) => g.pics.slice(0, 2).map((p) => absolute(p.src))),
  brand: { "@type": "Brand", name: "Bølgen Studio" },
  url: pageUrl,
  offers: groups.flatMap((g) =>
    g.variants.map((v) => ({
      "@type": "Offer",
      name: [g.color, v.size].filter(Boolean).join(" / "),
      price: Number(v.amount).toFixed(2),
      priceCurrency: product.currencyCode,
      availability: v.available ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
      itemCondition: "https://schema.org/NewCondition",
      url: g.color ? `${pageUrl}?color=${g.key}` : pageUrl,
    }))
  ),
};

/** Stående billeder står to og to; liggende fylder hele bredden. */
function galleryCells(pics: (typeof groups)[number]["pics"]) {
  const cells = pics.map((pic) => ({ pic, wide: pic.width > pic.height * 1.15 }));
  const narrowCount = cells.filter((c) => !c.wide).length;
  if (narrowCount % 2 === 1 && cells[0]) cells[0].wide = true;
  return { cells };
}
---

<Layout
  title={`${product.name} | Bølgen Studio`}
  description={lead}
  image={ogImage}
  ogType="product"
  jsonLd={jsonLd}
>
  <main class="pt-[calc(var(--nav-h)+env(safe-area-inset-top))]" data-product data-color={firstGroup?.key}>
    <div class="lg:grid lg:grid-cols-12">
      <!-- Galleri: ét pr. farve, kun det valgte vises -->
      <div class="lg:col-span-7 xl:col-span-8">
        {
          groups.map((group) => {
            const { cells } = galleryCells(group.pics);
            const isFirst = group === firstGroup;
            return (
              <div data-gallery={group.key} hidden={!isFirst}>
                <ul class="gallery no-scrollbar">
                  {cells.map(({ pic, wide }, i) => (
                    <li class={wide ? "gallery-cell is-wide" : "gallery-cell"}>
                      <img
                        src={pic.src}
                        srcset={pic.srcset}
                        sizes={wide ? "(min-width: 1024px) 62vw, 86vw" : "(min-width: 1024px) 31vw, 86vw"}
                        width={pic.width}
                        height={pic.height}
                        alt={pic.alt}
                        loading={isFirst && i < 2 ? "eager" : "lazy"}
                        fetchpriority={isFirst && i === 0 ? "high" : undefined}
                        decoding="async"
                        style={focusCrop(pic, 0.8) || undefined}
                      />
                    </li>
                  ))}
                </ul>
              </div>
            );
          })
        }
      </div>

      <!-- Køb -->
      <div class="lg:col-span-5 xl:col-span-4">
        <div class="buy px-4 pb-16 pt-8 sm:px-6 lg:px-10 lg:pb-10 lg:pt-10">
          <nav aria-label="Brødkrumme" class="label flex items-center gap-2">
            <a href="/#shop" class="hover:text-ink">Shop</a>
            <span aria-hidden="true">/</span>
            <span class="text-ink" aria-current="page">{shortName}</span>
          </nav>

          <h1 class="display mt-4 text-[clamp(3.25rem,6vw,5rem)]">{product.name}</h1>
          {product.subName && <p class="mt-2 text-ink-dim">{product.subName}</p>}

          <p class="mt-5 flex items-baseline gap-3">
            <span class="text-2xl font-semibold">{product.price}</span>
            <span class="text-sm text-ink-mute">inkl. moms</span>
          </p>

          <p class="mt-6 text-ink-dim">{lead}</p>

          <div class="mt-8 space-y-7">
            {
              product.hasColors && (
                <div>
                  <p class="label" id="color-label">
                    Farve <span class="ml-2 !text-ink" data-color-name>{firstGroup?.color}</span>
                  </p>
                  <div class="mt-3 flex flex-wrap gap-2" role="radiogroup" aria-labelledby="color-label">
                    {groups.map((group) => (
                      <button
                        type="button"
                        role="radio"
                        class="chip gap-2.5"
                        aria-checked={group === firstGroup ? "true" : "false"}
                        data-color-option={group.key}
                        data-color-label={group.color}
                      >
                        <span class="swatch" style={`background:${group.swatch}`} />
                        {group.color}
                      </button>
                    ))}
                  </div>
                </div>
              )
            }

            {
              product.hasVariants && (
                <div data-size-field>
                  <div class="flex items-center justify-between">
                    <p class="label" id="size-label">
                      Størrelse <span class="size-name ml-2 !text-ink" data-size-name aria-live="polite" />
                    </p>
                    <button type="button" class="link text-sm text-ink-dim" data-size-guide-open aria-haspopup="dialog">
                      Størrelsesguide
                    </button>
                  </div>
                  {groups.map((group) => (
                    <div
                      class="mt-3 flex flex-wrap gap-2"
                      role="radiogroup"
                      aria-labelledby="size-label"
                      data-sizes={group.key}
                      hidden={group !== firstGroup}
                    >
                      {group.variants.map((variant) => (
                        <button
                          type="button"
                          role="radio"
                          class="chip min-w-[4rem]"
                          aria-checked="false"
                          data-variant-id={variant.id}
                          data-size={variant.size}
                          data-soldout={variant.available ? undefined : "true"}
                          disabled={!variant.available}
                          aria-label={variant.available ? variant.size : `${variant.size} (udsolgt)`}
                        >
                          {variant.size}
                        </button>
                      ))}
                    </div>
                  ))}
                </div>
              )
            }

            <div>
              <button
                type="button"
                class="btn btn-primary w-full !min-h-[3.75rem] text-base"
                data-add-to-cart
                disabled={!product.available}
              >
                <span data-add-label>{product.available ? "Læg i kurv" : product.hasVariants ? "Udsolgt" : "Kan ikke købes lige nu"}</span>
                {product.available && <span class="opacity-60">{product.price}</span>}
              </button>
              {
                !product.hasVariants && (
                  <p class="mt-3 text-sm text-ink-mute">
                    Shoppen svarer ikke lige nu. Prøv igen om lidt, eller <a href="/contact" class="link">skriv til os</a>.
                  </p>
                )
              }
            </div>

            <p class="text-[0.9375rem] text-ink-dim">
              Levering på 2–4 hverdage i Danmark. 14 dages returret. Du betaler sikkert gennem Stripe.
            </p>
          </div>

          <div class="mt-10">
            {
              rest.length > 0 && (
                <details class="acc" open>
                  <summary>Om hoodien</summary>
                  <div class="acc-body space-y-4">
                    {rest.map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                  </div>
                </details>
              )
            }
            {
              specs.length > 0 && (
                <details class="acc">
                  <summary>Materiale &amp; konstruktion</summary>
                  <dl class="acc-body">
                    {specs.map(([term, value]) => (
                      <div class="flex justify-between gap-6 border-b py-2.5 hairline last:border-b-0">
                        <dt class="text-ink-mute">{term}</dt>
                        <dd class="text-right text-ink">{value}</dd>
                      </div>
                    ))}
                  </dl>
                </details>
              )
            }
            <details class="acc">
              <summary>Fragt &amp; returnering</summary>
              <div class="acc-body space-y-4">
                <p>Levering i Danmark tager typisk 2–4 hverdage. Fragten beregnes ved kassen.</p>
                <p>
                  Du har 14 dage fra modtagelse til at returnere ubrugte, uvaskede varer i original emballage.
                  <a href="/shipping" class="link text-ink">Læs mere om fragt og retur</a>.
                </p>
              </div>
            </details>
          </div>
        </div>
      </div>
    </div>

    {
      otherProducts.length > 0 && (
        <section class="wrap border-t py-16 hairline sm:py-24">
          <h2 class="display text-5xl sm:text-6xl">Mere fra Bølgen</h2>
          <div class="mt-8 grid gap-x-5 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
            {otherProducts.map((p) => {
              const pic = p.colorGroups[0]?.pics[0];
              return (
                <a href={`/product/${p.handle}`} class="group block">
                  <div class="aspect-[4/5] overflow-hidden bg-surface">
                    {pic && (
                      <img
                        src={pic.src}
                        srcset={pic.srcset}
                        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                        alt={pic.alt}
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover transition-transform duration-1000 ease-out group-hover:scale-[1.03]"
                      />
                    )}
                  </div>
                  <div class="mt-4 flex items-baseline justify-between gap-4">
                    <h3 class="text-lg font-semibold group-hover:underline">{p.name}</h3>
                    <p class="whitespace-nowrap">{p.price}</p>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )
    }

    <!-- Fast købsbjælke på mobil, når knappen er rullet ud af syne -->
    {
      product.available && (
        <div class="buybar" data-buybar aria-hidden="true">
          <div class="min-w-0 flex-1">
            <p class="truncate text-[0.9375rem] font-semibold">{product.name}</p>
            <p class="label mt-1.5" data-buybar-summary>
              {product.price}
            </p>
          </div>
          <button type="button" class="btn btn-primary !min-h-[3rem] shrink-0 px-6" data-buybar-button tabindex="-1">
            Læg i kurv
          </button>
        </div>
      )
    }

    <dialog id="size-guide" class="size-guide" aria-labelledby="size-guide-title">
      <div class="flex items-center justify-between border-b px-5 py-4 hairline">
        <h2 id="size-guide-title" class="text-lg font-semibold">Størrelsesguide</h2>
        <button type="button" class="link -mr-2 min-h-[2.75rem] px-2 text-[0.9375rem]" data-size-guide-close>Luk</button>
      </div>
      <div class="px-5 py-5">
        <table class="w-full text-left">
          <thead>
            <tr class="border-b hairline">
              <th class="label py-3 font-normal" scope="col">Størrelse</th>
              <th class="label py-3 font-normal" scope="col">Længde</th>
              <th class="label py-3 font-normal" scope="col">Bryst</th>
              <th class="label py-3 font-normal" scope="col">Ærme</th>
            </tr>
          </thead>
          <tbody class="text-[0.9375rem]">
            {
              SIZE_CHART_ROWS.map((row) => (
                <tr class="border-b hairline last:border-b-0">
                  <th class="py-3.5 font-medium text-ink" scope="row">{row.size}</th>
                  <td class="py-3.5 text-ink-dim">{row.length}</td>
                  <td class="py-3.5 text-ink-dim">{row.chest}</td>
                  <td class="py-3.5 text-ink-dim">{row.sleeve}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="mt-4 text-sm text-ink-mute">
          Alle mål er taget fladt. Hoodien er lavet til at sidde en smule cropped.
        </p>
      </div>
    </dialog>
  </main>

  <!-- Vælg farven fra URL'en før første tegning, så siden ikke blinker -->
  <script is:inline>
    (function () {
      var root = document.querySelector("[data-product]");
      var wanted = (new URLSearchParams(location.search).get("color") || "").toLowerCase();
      if (!root) return;
      // Uden gyldig farve i URL'en bruges den farve, siden er bygget med
      if (!/^[a-z0-9-]+$/.test(wanted) || !root.querySelector('[data-gallery="' + wanted + '"]')) {
        wanted = root.dataset.color || "";
      }
      if (!wanted) return;
      root.dataset.color = wanted;
      // Siden tager hoodiens farve: hvid bomuld eller sort
      if (wanted === "hvid" || wanted === "sort") document.documentElement.dataset.theme = wanted;
      root.querySelectorAll("[data-gallery], [data-sizes]").forEach(function (el) {
        el.hidden = (el.dataset.gallery || el.dataset.sizes) !== wanted;
      });
      // Farveknappen og farvenavnet skal også passe fra første tegning
      root.querySelectorAll("[data-color-option]").forEach(function (option) {
        var active = option.dataset.colorOption === wanted;
        option.setAttribute("aria-checked", String(active));
        var name = root.querySelector("[data-color-name]");
        if (active && name) name.textContent = option.dataset.colorLabel || "";
      });
    })();
  </script>
</Layout>

<script>
  import { addLine, openCart, toast } from "../../lib/cart";

  const root = document.querySelector<HTMLElement>("[data-product]");
  const addButton = document.querySelector<HTMLButtonElement>("[data-add-to-cart]");
  const addLabel = document.querySelector<HTMLElement>("[data-add-label]");
  const sizeField = document.querySelector<HTMLElement>("[data-size-field]");
  const sizeName = document.querySelector<HTMLElement>("[data-size-name]");
  const colorName = document.querySelector<HTMLElement>("[data-color-name]");
  const buybar = document.querySelector<HTMLElement>("[data-buybar]");
  const buybarButton = document.querySelector<HTMLButtonElement>("[data-buybar-button]");
  const buybarSummary = document.querySelector<HTMLElement>("[data-buybar-summary]");
  const basePrice = buybarSummary?.textContent?.trim() ?? "";

  let variantId: string | null = null;
  let busy = false;

  const sizeChips = (colorKey?: string) =>
    Array.from(
      document.querySelectorAll<HTMLButtonElement>(
        colorKey ? `[data-sizes="${colorKey}"] [data-variant-id]` : "[data-variant-id]"
      )
    );

  function refresh() {
    const picked = sizeChips().find((chip) => chip.getAttribute("aria-checked") === "true");
    variantId = picked?.dataset.variantId ?? null;
    const size = picked?.dataset.size ?? "";
    if (sizeName && (variantId || !sizeName.dataset.missing)) {
      sizeName.textContent = size;
      delete sizeName.dataset.missing;
    }

    const label = busy ? "Lægger i kurv…" : variantId ? "Læg i kurv" : "Vælg størrelse";
    if (addLabel && addButton && !addButton.disabled) addLabel.textContent = label;
    if (buybarButton) buybarButton.textContent = label;
    if (buybarSummary) {
      buybarSummary.textContent = [colorName?.textContent, size, basePrice].filter(Boolean).join(", ");
    }
  }

  function selectSize(chip: HTMLButtonElement | null) {
    sizeChips().forEach((c) => c.setAttribute("aria-checked", String(c === chip)));
    refresh();
  }

  function selectColor(key: string, updateUrl: boolean) {
    if (!root || !document.querySelector(`[data-gallery="${key}"]`)) return;
    const previousSize = sizeChips().find((c) => c.getAttribute("aria-checked") === "true")?.dataset.size;

    root.dataset.color = key;
    // Siden tager hoodiens farve: hvid bomuld eller sort
    if (key === "hvid" || key === "sort") {
      if (updateUrl) document.documentElement.classList.add("theme-fade");
      document.documentElement.dataset.theme = key;
    } else {
      delete document.documentElement.dataset.theme;
    }
    document.querySelectorAll<HTMLElement>("[data-gallery], [data-sizes]").forEach((el) => {
      el.hidden = (el.dataset.gallery ?? el.dataset.sizes) !== key;
    });
    document.querySelectorAll<HTMLElement>("[data-color-option]").forEach((option) => {
      const active = option.dataset.colorOption === key;
      option.setAttribute("aria-checked", String(active));
      if (active && colorName) colorName.textContent = option.dataset.colorLabel ?? "";
    });
    document.querySelector<HTMLElement>(`[data-gallery="${key}"] .gallery`)?.scrollTo({ left: 0 });

    // Behold den valgte størrelse, hvis den findes i den nye farve
    const same = sizeChips(key).find((c) => c.dataset.size === previousSize && !c.disabled) ?? null;
    selectSize(same);

    if (updateUrl) {
      const url = new URL(window.location.href);
      url.searchParams.set("color", key);
      window.history.replaceState({}, "", url);
    }
  }

  async function add() {
    if (busy || !addButton || addButton.disabled) return;
    if (!variantId) {
      // Beskeden står i etiketten ved siden af "Størrelse", så intet på siden flytter sig
      if (sizeName) {
        sizeName.dataset.missing = "true";
        sizeName.textContent = "Vælg en størrelse først";
      }
      // Rul kun, hvis størrelserne ikke allerede kan ses
      const rect = sizeField?.getBoundingClientRect();
      if (rect && (rect.top < 80 || rect.bottom > window.innerHeight - 80)) {
        sizeField?.scrollIntoView({ behavior: "smooth", block: "center" });
      }
      sizeChips(root?.dataset.color)
        .find((c) => !c.disabled)
        ?.focus({ preventScroll: true });
      return;
    }
    busy = true;
    refresh();
    try {
      await addLine(variantId, 1);
      openCart();
    } catch (err) {
      console.error("[læg i kurv]", err);
      toast("Varen kunne ikke lægges i kurven. Prøv igen.", "error");
    } finally {
      busy = false;
      refresh();
    }
  }

  document.querySelectorAll<HTMLButtonElement>("[data-color-option]").forEach((option) => {
    option.addEventListener("click", () => selectColor(option.dataset.colorOption ?? "", true));
  });
  sizeChips().forEach((chip) => chip.addEventListener("click", () => selectSize(chip)));
  addButton?.addEventListener("click", add);
  buybarButton?.addEventListener("click", add);

  // Synkronisér med farven, som inline-scriptet allerede har valgt ud fra URL'en
  if (root?.dataset.color) selectColor(root.dataset.color, false);
  else refresh();

  // Har farven kun én størrelse på lager, er valget givet
  const only = sizeChips(root?.dataset.color).filter((c) => !c.disabled);
  if (only.length === 1 && sizeChips(root?.dataset.color).length === 1) selectSize(only[0]);

  if (buybar && addButton && "IntersectionObserver" in window) {
    new IntersectionObserver(([entry]) => {
      const show = !entry.isIntersecting && entry.boundingClientRect.top < 0;
      buybar.classList.toggle("is-in", show);
      buybar.setAttribute("aria-hidden", String(!show));
      buybarButton?.setAttribute("tabindex", show ? "0" : "-1");
    }).observe(addButton);
  }

  // Hent den anden farves første billeder i baggrunden, så farveskift ikke starter med tomme felter
  const warmUp = () => {
    document.querySelectorAll<HTMLElement>("[data-gallery][hidden]").forEach((gallery) => {
      Array.from(gallery.querySelectorAll<HTMLImageElement>("img[loading='lazy']"))
        .slice(0, 3)
        .forEach((img) => {
          img.loading = "eager";
        });
    });
  };
  if ("requestIdleCallback" in window) requestIdleCallback(warmUp, { timeout: 3000 });
  else setTimeout(warmUp, 1500);

  const sizeGuide = document.getElementById("size-guide") as HTMLDialogElement | null;
  document.querySelector("[data-size-guide-open]")?.addEventListener("click", () => sizeGuide?.showModal());
  document.querySelector("[data-size-guide-close]")?.addEventListener("click", () => sizeGuide?.close());
  sizeGuide?.addEventListener("click", (e) => {
    if (e.target === sizeGuide) sizeGuide.close();
  });
</script>

<style>
  /* Mobil: vandret galleri man swiper i. Desktop: billederne står i et gitter og ruller med siden. */
  .gallery {
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
  }

  .gallery-cell {
    position: relative;
    flex: 0 0 86%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--surface);
    scroll-snap-align: start;
  }

  .gallery-cell:only-child {
    flex-basis: 100%;
  }

  .gallery-cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }


  @media (min-width: 1024px) {
    .gallery {
      display: grid;
      grid-template-columns: 1fr 1fr;
      overflow: visible;
    }

    .gallery-cell.is-wide {
      grid-column: span 2;
      aspect-ratio: 3 / 2;
    }


  }

  /* Farveskift: det nye galleri tones roligt ind */
  [data-gallery] {
    animation: gallery-in 0.35s ease both;
  }

  @keyframes gallery-in {
    from {
      opacity: 0;
    }
  }

  .size-name[data-missing] {
    color: var(--warn) !important;
  }

  .swatch {
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 999px;
    border: 1px solid rgb(128 128 128 / 0.6);
  }

  .acc {
    border-top: 1px solid var(--line);
  }

  .acc:last-of-type {
    border-bottom: 1px solid var(--line);
  }

  .acc summary {
    display: flex;
    min-height: 3.5rem;
    cursor: pointer;
    list-style: none;
    align-items: center;
    justify-content: space-between;
    font-weight: 500;
  }

  .acc summary::-webkit-details-marker {
    display: none;
  }

  .acc summary::after {
    content: "+";
    font-size: 1.125rem;
    color: var(--ink-mute);
    transition: transform 0.3s var(--ease-out);
  }

  .acc[open] summary::after {
    transform: rotate(45deg);
  }

  .acc-body {
    padding-bottom: 1.5rem;
    font-size: 0.9375rem;
    color: var(--ink-dim);
  }

  @media (min-width: 1024px) {
    .buybar {
      display: none !important;
    }
  }

  .buybar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1rem max(0.75rem, env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-top: 1px solid var(--line);
    transform: translateY(110%);
    transition: transform 0.4s var(--ease-out);
  }

  .buybar.is-in {
    transform: none;
  }

  .size-guide {
    width: min(32rem, calc(100vw - 2rem));
    margin: auto;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    background: var(--surface);
  }

