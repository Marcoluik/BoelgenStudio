---
import InfoPage from "../layouts/InfoPage.astro";
import { SIZE_CHART_ROWS } from "../lib/size-chart";
---

<InfoPage
  title="Fragt & returnering | Bølgen Studio"
  heading="Fragt & returnering"
  description="Levering på 2–4 hverdage i Danmark, 14 dages returret og størrelsesguide til Bølgen-hoodien."
  eyebrow="Hjælp"
  updated="Februar 2026"
>
  <section>
    <h2>Fragt</h2>
    <p>Levering i Danmark tager typisk 2-4 hverdage. Fragtomkostninger beregnes ved kassen.</p>
  </section>

  <section>
    <h2>Returnering</h2>
    <p>
      Du har 14 dage fra modtagelse til at returnere ubrugte, uvaskede varer i original emballage. Start en returnering
      ved at kontakte os på mail. Vi behandler refusioner inden for 14 dage efter modtagelse.
    </p>
  </section>

  <section id="size-guide">
    <h2>Størrelsesguide</h2>
    <p>Alle mål er taget fladt. Vores tøj er lavet til at sidde en smule cropped.</p>
    <table>
      <thead>
        <tr>
          <th scope="col">Størrelse</th>
          <th scope="col">Længde</th>
          <th scope="col">Bryst</th>
          <th scope="col">Ærme</th>
        </tr>
      </thead>
      <tbody>
        {
          SIZE_CHART_ROWS.map((row) => (
            <tr>
              <th scope="row">{row.size}</th>
              <td>{row.length}</td>
              <td>{row.chest}</td>
              <td>{row.sleeve}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section>
    <h2>Kontakt</h2>
    <p>Spørgsmål om fragt eller returnering? <a href="/contact">Kontakt os</a></p>
  </section>
</InfoPage>
