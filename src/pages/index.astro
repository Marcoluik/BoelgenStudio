---
import Craft from "../components/Craft.astro";
import Hero from "../components/Hero.astro";
import Lookbook from "../components/Lookbook.astro";
import Shop from "../components/Shop.astro";
import Layout from "../layouts/Layout.astro";
import { getProducts } from "../lib/products";

const products = await getProducts();
const signature = products.find((p) => p.isSignature) ?? products[0];
const productHref = signature ? `/product/${signature.handle}` : "#shop";
const site = Astro.site?.toString().replace(/\/$/, "") ?? "";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Bølgen Studio",
    url: site,
    logo: `${site}/logo-bolgen.svg`,
    sameAs: ["https://instagram.com/boelgen.studio"],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Bølgen Studio",
    url: site,
    inLanguage: "da-DK",
  },
];
---

<Layout title="Bølgen Studio | Tøj til livet ved havet" overlayNav jsonLd={jsonLd}>
  <main>
    <Hero price={signature?.price} />
    <Shop products={products} />
    {signature?.isSignature && <Craft productHref={productHref} />}
    <Lookbook />
  </main>
</Layout>

<script>
  import { toast } from "../lib/cart";

  // Tilbage fra nyhedsbrevs-tilmeldingen
  const url = new URL(window.location.href);
  if (url.searchParams.has("tilmeldt")) {
    url.searchParams.delete("tilmeldt");
    window.history.replaceState({}, "", url);
    setTimeout(() => toast("Tak, du er tilmeldt nyhedsbrevet."), 600);
  }
</script>
