---
import InfoPage from "../layouts/InfoPage.astro";

const formSubmitRecipient =
  import.meta.env.PUBLIC_FORMSUBMIT_RECIPIENT?.trim() || "8713123e93f6baf78af5e327439c1129";
const useFormSubmit = Boolean(formSubmitRecipient);
const siteBase = import.meta.env.SITE?.replace(/\/$/, "") ?? "";
const formAction = useFormSubmit ? `https://formsubmit.co/${encodeURIComponent(formSubmitRecipient)}` : undefined;
const redirectAfterSubmit = useFormSubmit && siteBase ? `${siteBase}/contact?success=1` : "";
---

<InfoPage
  title="Kontakt | Bølgen Studio"
  heading="Kontakt"
  description="Kontakt Bølgen Studio. Spørgsmål om ordrer, fragt eller kollektionen."
  eyebrow="Hjælp"
  intro="Spørgsmål om ordrer, fragt eller kollektionen? Vi svarer typisk inden for 24–48 timer."
>
  <div id="contact-thanks" class="hidden border p-6 hairline sm:p-8" role="status">
    <p class="text-xl font-semibold text-ink">Tak for din besked.</p>
    <p class="mt-2">Vi har modtaget den og vender tilbage hurtigst muligt.</p>
    <a href="/contact" class="mt-5 inline-block">Send en ny besked</a>
  </div>

  <form
    id="contact-form"
    class="space-y-7"
    method="POST"
    {...useFormSubmit
      ? { action: formAction }
      : { name: "contact", "data-netlify": "true", "netlify-honeypot": "bot-field" }}
  >
    {
      useFormSubmit ? (
        <>
          <input type="hidden" name="_subject" value="Kontakt — Bølgen Studio" />
          {redirectAfterSubmit && <input type="hidden" name="_next" value={redirectAfterSubmit} />}
        </>
      ) : (
        <>
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label>
              Udfyld ikke dette: <input name="bot-field" />
            </label>
          </p>
        </>
      )
    }

    <div>
      <label for="name" class="label">Navn</label>
      <input type="text" id="name" name="name" required autocomplete="name" class="field mt-1" />
    </div>

    <div>
      <label for="email" class="label">E-mail</label>
      <input type="email" id="email" name="email" required autocomplete="email" class="field mt-1" placeholder="din@email.dk" />
    </div>

    <div>
      <label for="message" class="label">Besked</label>
      <textarea id="message" name="message" required rows="5" class="field mt-1 resize-none" placeholder="Hvordan kan vi hjælpe?"></textarea>
    </div>

    <button type="submit" class="btn btn-primary w-full sm:w-auto sm:min-w-[14rem]">Send besked</button>

    <p class="text-sm text-ink-mute">
      Eller find os på <a href="https://instagram.com/boelgen.studio" target="_blank" rel="noopener noreferrer">Instagram</a>.
    </p>
  </form>

  <script is:inline>
    (function () {
      try {
        if (new URLSearchParams(window.location.search).get("success") === "1") {
          document.getElementById("contact-thanks")?.classList.remove("hidden");
          document.getElementById("contact-form")?.classList.add("hidden");
          window.history.replaceState({}, "", window.location.pathname);
        }
      } catch (_) {}
    })();
  </script>
</InfoPage>
