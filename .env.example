# Kopiér til .env til lokal udvikling. I produktion sættes værdierne i Netlify
# (Site configuration > Environment variables). Læg aldrig rigtige nøgler i git.
#
# Opsætning:
#   bolgenstudio.com -> Netlify (Astro-site + serverfunktioner i netlify/functions)
#   Betaling         -> Stripe Checkout
#   Produkter, lager og ordrer -> Postgres hos Neon (skema i backend/db/schema.sql)

# Postgres-forbindelse fra Neon ("Connect" i Neon-konsollen). Bruges både ved build
# (produktsiderne) og af serverfunktionerne.
DATABASE_URL=

# Stripe: hemmelig nøgle (sk_test_... / rk_live_...) med rettigheden "Checkout Sessions: Write"
STRIPE_SECRET_KEY=
# Stripe: signeringshemmelighed (whsec_...) fra webhooken, der peger på /api/stripe-webhook
STRIPE_WEBHOOK_SECRET=

# Sitets adresse uden skråstreg til sidst; bruges til retur-links fra Stripe
SITE_URL=https://bolgenstudio.com

# Fragt i øre (4900 = 49 kr.). Uden SHIPPING_FLAT_ORE er fragten gratis.
SHIPPING_FLAT_ORE=
# Valgfri: gratis fragt fra dette ordrebeløb i øre
FREE_SHIPPING_OVER_ORE=

# Adgangskode til /admin (mindst 12 tegn)
ADMIN_PASSWORD=

# Contact + nyhedsbrev: modtageradresse (FormSubmit — gratis, første besked aktiverer formularen).
# Hvis tom: Netlify Forms (kun hvis siden hostes på Netlify).
PUBLIC_CONTACT_EMAIL=
